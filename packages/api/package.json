    "@vaultbench/shared": "workspace:*",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.10.7",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@types/node": "^22.20.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
