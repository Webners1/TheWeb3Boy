    "/entities/{id}/followers": {
      "get": {
        "tags": [
          "entities"
        ],
        "summary": "The depositor cross-section and its return distribution",
        "description": "The gap between an entity's return and its median follower's is the number that matters to somebody deciding whether to copy it, and it is the number no venue publishes.",
