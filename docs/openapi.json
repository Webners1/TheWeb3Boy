    "/metrics/definitions": {
      "get": {
        "tags": [
          "metrics"
        ],
        "summary": "What every metric means, and when it misleads",
        "description": "Served from the `metric_definitions` table, not from this codebase. A metric only a frontend can interpret is invisible to an agent, so the semantics live in the database next to the numbers.",
        "responses": {
          "200": {
            "description": "Metric semantics.",
