{
  "name": "vaultbench",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "pnpm run check:harness && pnpm run typecheck && pnpm run test",
    "check:harness": "node tools/check-harness.mjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "ingest": "pnpm --filter @vaultbench/ingest start --",
    "backfill": "pnpm --filter @vaultbench/backfill start --",
    "recompute": "pnpm --filter @vaultbench/compute run recompute --",
    "db:generate": "pnpm --filter @vaultbench/db run generate"
  },
  "devDependencies": {
    "turbo": "^2.10.12",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
