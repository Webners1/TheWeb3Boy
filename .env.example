# Postgres connection string for the ingest/backfill jobs and drizzle-kit.
# Never commit a real value — CI reads this from repository secrets.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/vaultbench

# Raw payload archive. Defaults to ./var/archive (append-only, gzipped).
# Set S3_* to use Cloudflare R2 or Supabase Storage instead.
ARCHIVE_ROOT=./var/archive

# S3_BUCKET=
# S3_ENDPOINT=
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true

# OKX public API. Default https://www.okx.com — some networks need a regional
# host. Do not scrape; this is the documented REST API.
# OKX_API_BASE=https://www.okx.com

# Chamber (formerly dHEDGE) hosted Data API. Public, no key required.
# CHAMBER_API_URL=https://api-v2.dhedge.org/graphql

# Chains to discover Chamber vaults on. Defaults to all six known-good codes.
# Narrow it only for local testing: dropping a chain drops its whole universe,
# and the missing vaults look delisted rather than unqueried.
# CHAMBER_CHAINS=POLYGON,OPTIMISM,ARBITRUM,BASE,MAINNET,HYPEREVM

# Enzyme API. Free self-serve key from https://app.enzyme.finance/account/api-tokens.
# The adapter is not built yet — see docs/traps.md. Without a key there is no
# way to verify the response shape, and an adapter written against a guessed
# shape is worse than no adapter.
# ENZYME_API_KEY=

# Test/smoke only. Never set in production — the Hyperliquid universe must be
# complete or the empty-array guard is lying.
# HYPERLIQUID_MAX_VAULTS=
